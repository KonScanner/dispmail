# Copy to .env (gitignored). Nothing here is required for a direct VPN/hotspot route.
# All values are read by `dispmail` only; never commit a real .env.

# Optional paid HTTP/SOCKS proxy (leave empty for a direct route).
DISPMAIL_PROXY_SERVER=
DISPMAIL_PROXY_USERNAME=
DISPMAIL_PROXY_PASSWORD=

# What the pre-flight check must observe. Country is ISO-3166 alpha-2.
DISPMAIL_EGRESS_NAME=direct
DISPMAIL_EGRESS_COUNTRY=GR
# Optional ASN (integer) and the IP that must never be used.
# DISPMAIL_EGRESS_ASN=20473
# DISPMAIL_HOME_IP=

# Where state/ledgers live and where accounts are written.
# DISPMAIL_STATE_DIR=./.dispmail-state
# DISPMAIL_DATA_DIR=./data
# DISPMAIL_ARTIFACTS_DIR=./artifacts

# Defaults: headless dry-run, no submission.
# DISPMAIL_HEADLESS=true
# DISPMAIL_SUBMIT=false
# DISPMAIL_MANUAL=false
# DISPMAIL_ASSISTED=false
# DISPMAIL_ACCEPT_ATTESTATION=false
# DISPMAIL_REPLACE_ACCOUNT=false
# DISPMAIL_SEED=
# DISPMAIL_TIMEOUT=10
# DISPMAIL_NAVIGATION_TIMEOUT=30
# DISPMAIL_SUBMIT_TIMEOUT=60
# DISPMAIL_ASSIST_TIMEOUT=600
